# =================== System: Kibana Server ===================
#server.port: 5601
server.host: "0.0.0.0"
server.name: "kibana"
server.publicBaseUrl: "http://kbn:5601"

# =================== System: Kibana Server (Optional) ===================
#server.ssl.enabled: false
#server.ssl.certificate: /path/to/your/server.crt
#server.ssl.key: /path/to/your/server.key

# =================== System: Elasticsearch ===================
elasticsearch.hosts: [{{ groups['elasticsearch'] | map('regex_replace', '^(.*)$', '"https://\\1:9200"') | join(',') }}]
elasticsearch.username: "kibana_system"
elasticsearch.password: "{{ account_password.kibana_system }}"

# =================== System: Elasticsearch (Optional) ===================
elasticsearch.ssl.certificateAuthorities: [ "{{ ca_cert_path }}" ]
#elasticsearch.ssl.certificate: /path/to/your/client.crt
#elasticsearch.ssl.key: /path/to/your/client.key
#elasticsearch.ssl.verificationMode: full

# =================== Security ===================
xpack.security.audit.enabled: true # License needed
xpack.security.encryptionKey: "{{ security_encryptionKey }}"

# =================== Alerting and action ===================
xpack.encryptedSavedObjects.encryptionKey: "{{ encryptedSavedObjects_encryptionKey }}"

# =================== Reporting ===================
xpack.reporting.encryptionKey: "{{ reporting_encryptionKey }}"

# =================== System: Logging ===================
logging.root.level: info

logging:
  appenders:
    file:
      type: file
      fileName: /var/log/kibana/kibana.log
      layout:
        type: json
  root:
    appenders:
      - default
      - file
#  layout:
#    type: json

logging.loggers:
  - name: elasticsearch.query
    level: info
  - name: http.server.response
    level: info
  - name: metrics.ops
    level: info

# =================== Monitoring ===================

monitoring.ui.ccs.enabled: false

# ====================== Fleet =====================

xpack.fleet.agents.fleet_server.hosts: [{{ groups['fleet_server'] | map('regex_replace', '^(.*)$', '"https://\\1:8220"') | join(',') }}]

xpack.fleet.packages:
  - name: system 
    version: latest
  - name: fleet_server 
    version: latest 
  - name: elastic_agent
    version: latest
  - name: apm
    version: latest

xpack.fleet.agentPolicies:
  - name: Fleet Server Policy 
    id: fleet_server_policy
    description: Default Fleet Server policy
    namespace: default
    monitoring_enabled: ['logs', 'metrics']
    is_managed: false
    is_default_fleet_server: true
    package_policies:
      - name: system-1
        package:
          name: system
      - name: fleet_server
        package:
          name: fleet_server
        inputs:
          - type: fleet-server
            keep_enabled: true
            vars:
              - name: host
                value: 0.0.0.0
                frozen: false
              - name: port
                value: 8220
                frozen: false
  - name: APM Server Policy
    id: apm_server_policy
    description: Default APM Server policy
    namespace: default
    monitoring_enabled: ['logs', 'metrics']
    is_managed: false
    is_default: false
    package_policies:
      - name: system-2
        package:
          name: system
      - name: apm
        package:
          name: apm
        inputs:
          - type: apm
            keep_enabled: true
            vars:
              - name: host
                value: 0.0.0.0:8200
                frozen: false
              - name: url
                value: "https://localhost:8200"
                frozen: false
              - name: enable_rum
                value: true
                frozen: false
              - name: tls_enabled
                value: true
                frozen: false
              - name: tls_certificate
                value: "/etc/elastic-agent/certs/{{ elastic_stack.cert_name }}.crt"
                frozen: false
              - name: tls_key
                value: "/etc/elastic-agent/certs/{{ elastic_stack.cert_name }}.key"
                frozen: false

xpack.fleet.outputs:
  - id: fleet-default-output
    name: Default output
    type: elasticsearch
    hosts: [{{ groups['elasticsearch'] | map('regex_replace', '^(.*)$', '"https://\\1:9200"') | join(',') }}]
    is_default: true
    is_default_monitoring: true
    config:
      ssl.certificate_authorities: ["/etc/elastic-agent/certs/{{ elastic_stack.ca_name }}.crt"]